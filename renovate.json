{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^Dockerfile$/"
            ],
            "matchStrings": [
                "#\\s*renovate-github-release:\\s*repo=(?<packageName>.*?)?\\sARG .*_VERSION=\"(?<currentValue>.*)\""
            ],
            "datasourceTemplate": "github-releases"
        }
    ],
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["golang"],
            "matchUpdateTypes": ["pin", "pinDigest", "digest", "minor", "patch"],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true
        },
        {
            "description": "Automerge GitHub Actions minor/patch updates (by Muse)",
            "matchManagers": ["github-actions"],
            "matchPackageNames": ["actions/*", "docker/*", "sigstore/*"],
            "matchUpdateTypes": ["minor", "patch"],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true,
            "ignoreTests": false
        }
    ],
    "assignees": [
        "mkaraki"
    ],
    "pinDigests": true
}
